# ==========================================
# AI INCIDENT RESPONSE PLATFORM CONFIGURATION
# ==========================================

# Application Settings
PROJECT_NAME="AI-Powered Incident Response & Root Cause Analysis Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL in Docker / Local)
# When using Docker Compose:
DATABASE_URL="postgresql://postgres:postgres@db:5432/incident_platform"

# Or configure individual PostgreSQL parameters:
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="incident_platform"
POSTGRES_PORT=5432

# Authentication & Security
# Generate a secure 32+ character key: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Supported options: 'heuristic' (zero-config SRE expert), 'openai', 'gemini', 'ollama'
AI_PROVIDER="heuristic"
AI_TIMEOUT_SECONDS=30.0
PROMPT_VERSION="incident_analysis_v1"

# OpenAI Configuration (if AI_PROVIDER="openai")
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini Configuration (if AI_PROVIDER="gemini")
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-flash"

# Local Ollama Configuration (if AI_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# CORS Configuration (comma-separated origins or list)
CORS_ORIGINS=["*"]
